<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Westwing Clone</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Font Awesome for icons -->
</head>
<body>
<header>
    <!-- Top Promotional Bar -->
    <div class="top-promo-bar">
        Use o voucher <strong>FRETE</strong> e ganhe frete grátis acima de <strong>R$ 249</strong>
    </div>

    <!-- Main Header Section (Logo, Search, Icons) -->
    <div class="main-header-container">
        <a href="/" class="logo">Reflexo Nobre</a>

        <div class="search-bar">
            <input type="text" placeholder="Busque por produtos ou marcas"/>
            <i class="fas fa-search search-icon"></i>
        </div>

        <div class="user-actions">
            <a href="#" class="action-item">
                <i class="far fa-heart"></i>
            </a>
            <a href="#" class="action-item profile">
                <i class="far fa-user"></i>
                <span>Cadastre-se</span>
            </a>
            <a href="#" class="action-item">
                <i class="fas fa-shopping-cart"></i>
            </a>
        </div>
    </div>

    <!-- Main Navigation Menu -->
    <nav class="main-nav">
        <ul>
            <li><a href="#">Faça seu projeto</a></li>
            <li class="active"><a href="#">Westwing Collection</a></li>
            <li><a href="#">Móveis</a></li>
            <li><a href="#">Cama e Banho</a></li>
            <li><a href="#">Decoração e Iluminação</a></li>
            <li><a href="#">Tapetes e Cortinas</a></li>
            <li><a href="#">Mesa posta</a></li>
            <li><a href="#">Cozinha</a></li>
            <li><a href="#">Lifestyle</a></li>
        </ul>
    </nav>
</header>

<main role="main" class="pb-3">
    @RenderBody()
</main>

<!-- Optional: Add footer or other common elements here -->


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>